#!/bin/sh
set -e

echo ""
echo "🛡️  [pre-push] Verificando calidad y compatibilidad con CI antes del push..."
echo ""

# 1. Validar integridad de JSONs de configuración (igual que CI verify job)
echo "→ [1/3] Validando configuración JSON y archivos web requeridos..."
node -e "for (const f of ['package.json','vercel.json','manifest.json']) JSON.parse(require('fs').readFileSync(f, 'utf8'))"

if [ ! -s index.html ]; then
  echo "❌ [pre-push] Error: index.html no existe o está vacío." >&2
  exit 1
fi

# 2. Ejecutar la suite determinista completa de calidad (igual que CV quality job)
echo "→ [2/3] Ejecutando suite determinista (PDFs, Web, Layout 18 tamaños, WCAG 2.1 AA)..."
cd scripts
npm run check

echo ""
echo "✅ [pre-push] Todas las pruebas han pasado satisfactoriamente (0 errores)."
echo "🚀 Procediendo con el push a GitHub..."
echo ""
exit 0
